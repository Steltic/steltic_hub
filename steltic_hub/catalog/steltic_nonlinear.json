          }
        ]
      },
      "fields": [
        {
          "id": "job",
          "type": "project",
          "label": "Project",
          "required": true
        },
        {
          "id": "package",
          "type": "file",
          "label": "Steltic design package",
          "accept": ".zip",
          "default": "{out.steltic}",
          "placeholder": "this project's HR Steel design (automatic)",
