{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steltic",
  "version": "0.1.0",
  "identifier": "com.stelticai.hub",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [{
      "title": "Steltic",
      "width": 1440, "height": 940, "minWidth": 1040, "minHeight": 680,
      "resizable": true, "visible": false, "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["English"] },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
